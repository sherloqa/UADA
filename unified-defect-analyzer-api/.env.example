# MongoDB Atlas Connection URI (REQUIRED)
# Get this from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?appName=appName
MONGODB_URI=mongodb+srv://dbUser:password@cluster0.xxxxx.mongodb.net/unified-defect-analyzer?appName=Cluster0

# API Server Port (Optional - defaults to 3000)
PORT=3000

# Environment (Optional - defaults to development)
NODE_ENV=development

# Log Level (Optional - defaults to info)
LOG_LEVEL=info
